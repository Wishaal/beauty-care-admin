APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Database backup / restore (config/backup.php).
# Defaults to the DB_* connection above when left blank.
BACKUP_DB_HOST=
BACKUP_DB_DATABASE=
BACKUP_DB_USERNAME=
BACKUP_DB_PASSWORD=
BACKUP_DUMP_FILE=backup.sql

# Offsite upload. Leave BACKUP_FTP_HOST empty to skip the upload entirely.
# Keep BACKUP_FTP_SSL=true — plain FTP sends the password in clear text.
BACKUP_FTP_HOST=
BACKUP_FTP_USERNAME=
BACKUP_FTP_PASSWORD=
BACKUP_FTP_REMOTE_PATH=
BACKUP_FTP_SSL=true
